# Ports below match deploy/docker-compose.yml, which maps Postgres/Redis to
# non-default host ports (55432/56379) to avoid clashing with other services
# already running on this machine -- adjust if your setup differs.
DATABASE_URL=postgresql+asyncpg://opportunity:opportunity@localhost:55432/opportunity_platform
CHECKPOINT_DATABASE_URL=postgresql://opportunity:opportunity@localhost:55432/opportunity_platform
REDIS_URL=redis://localhost:56379/0
LOG_LEVEL=INFO
APP_ENV=local

# --- Chat / structured-generate LLM (spec §75) ------------------------------
# Drives analyze_event / expert_judge / mini_review / the collector's
# FILTER_RELEVANCE small-LLM layer -- all four task_types share this one
# model (per-task_type Model Profile routing from spec §77 is deferred past
# one-期; ADR-0004). LLM_PROVIDER=stub (default) needs nothing else below and
# makes no network calls.
LLM_PROVIDER=stub
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
#
# Any OpenAI-compatible chat-completions endpoint works here, e.g.:
#   DeepSeek:   LLM_MODEL=deepseek-chat        LLM_BASE_URL=https://api.deepseek.com
#   Moonshot:   LLM_MODEL=moonshot-v1-8k       LLM_BASE_URL=https://api.moonshot.cn/v1
#   Qwen/百炼:   LLM_MODEL=qwen-plus            LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# These three only expose chat completions, NOT an embeddings endpoint --
# setting one of them here has no effect on embeddings (see below), by
# design (ADR-0004). Don't assume LLM_PROVIDER also controls embed().

# --- Embedding LLM (spec §77: "Embedding → 独立Embedding模型") --------------
# Independently configured/selected from the chat LLM above (ADR-0004) --
# used for RAG ingestion/retrieval (app/knowledge/). Defaults to stub
# (no network calls) even if LLM_PROVIDER above is set to a real provider;
# you must opt in here explicitly.
EMBEDDING_PROVIDER=stub
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=BGE-m3
# EMBEDDING_BASE_URL=https://your-provider/v1
#
# Pick a vendor that actually serves embeddings -- DeepSeek/Moonshot above do
# not. OpenAI, Qwen/百炼 (DashScope, compatible-mode base_url as above), or
# any relay serving an open embedding model (e.g. BGE-m3) all work.
#
# The pgvector columns (app/models/knowledge.py's EMBEDDING_DIMENSION,
# migrations/versions/0006_*) are currently fixed at 1024 dims, sized for
# BGE-m3 -- this is a real schema constraint, not just config. There is no
# way to "auto-detect" it: pgvector needs one fixed width per column (all
# rows in knowledge_chunk/capability must be directly comparable), and no
# vendor's API reports its output size ahead of a real call. Switching to a
# model with a different output size (OpenAI text-embedding-3-small is
# 1536-dim, for example) means writing one more Alembic migration to resize
# the column, the same way 0006 did for BGE-m3 -- EMBEDDING_DIMENSION below
# does NOT drive the real schema, it only sizes EMBEDDING_PROVIDER=stub's
# fake vectors (keep it equal to whatever the migrated column width
# currently is, or stub-mode inserts will fail against a real schema too).
EMBEDDING_DIMENSION=1024

# --- Collector -------------------------------------------------------------
# Caps how many list-page items one collection cycle processes per source
# (newest first -- list pages are newest-first on every real source verified
# so far). Anything past this is picked up on the next scheduled run, not
# lost. Without a cap, a dense source (dozens of items per page) makes every
# run take as long as its slowest/most LLM-fallback-heavy item.
COLLECTOR_MAX_ITEMS_PER_RUN=5
# Set to false to disable the APScheduler cron loop entirely (e.g. while
# testing "立即抓取" by hand and you don't want scheduled runs interleaving).
COLLECTOR_SCHEDULER_ENABLED=true

# DingTalk custom-robot webhooks (spec §63) -- unset by default, which makes
# the app use RecordingDeliveryChannel (records calls, never sends anything
# real) instead of the real DingTalkAdapter. Fill these in once you have a
# real webhook to push to; no code changes needed. Two separate webhooks:
# the main group (owner @-mentions) and the public fallback group (spec §62,
# used when no Customer Owner is configured for a department).
# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=...
# DINGTALK_WEBHOOK_SECRET=SEC...
# DINGTALK_PUBLIC_GROUP_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=...
# DINGTALK_PUBLIC_GROUP_WEBHOOK_SECRET=SEC...
