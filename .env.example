# Ports below match deploy/docker-compose.yml, which maps Postgres/Redis to
# non-default host ports (55432/56379) to avoid clashing with other services
# already running on this machine -- adjust if your setup differs.
DATABASE_URL=postgresql+asyncpg://opportunity:opportunity@localhost:55432/opportunity_platform
CHECKPOINT_DATABASE_URL=postgresql://opportunity:opportunity@localhost:55432/opportunity_platform
REDIS_URL=redis://localhost:56379/0
LLM_PROVIDER=stub
LOG_LEVEL=INFO
APP_ENV=local

# DingTalk custom-robot webhooks (spec §63) -- unset by default, which makes
# the app use RecordingDeliveryChannel (records calls, never sends anything
# real) instead of the real DingTalkAdapter. Fill these in once you have a
# real webhook to push to; no code changes needed. Two separate webhooks:
# the main group (owner @-mentions) and the public fallback group (spec §62,
# used when no Customer Owner is configured for a department).
# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=...
# DINGTALK_WEBHOOK_SECRET=SEC...
# DINGTALK_PUBLIC_GROUP_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=...
# DINGTALK_PUBLIC_GROUP_WEBHOOK_SECRET=SEC...
